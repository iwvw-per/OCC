{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OCC",
  "version": "2.0.0",
  "identifier": "com.opencodeui.occ",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5176",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OCC",
        "width": 800,
        "height": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 14
        },
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "notification": null,
    "updater": {
      "endpoints": ["https://github.com/iwvw-per/OCC/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFMjlFRkU5NjIzM0RDNkEKUldScTNETmk2ZThwUHJRRnlvbHNBd0FnRzQ5SllQZ1B5QTRTNkdjTFpKdCs4TE1URVFrc0E2SUUK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis", "dmg", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsi"
      }
    }
  }
}
